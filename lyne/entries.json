{
  "keybinds": [
    { "description": "CpuPower Low", "command": "~/.local/bin/nitro-cpu Low", "keys": "CTRL + ALT + 1" },
    { "description": "CpuPower Base", "command": "~/.local/bin/nitro-cpu Base", "keys": "CTRL + ALT + 2" },
    { "description": "CpuPower High", "command": "~/.local/bin/nitro-cpu High", "keys": "CTRL + ALT + 3" },
    { "description": "CpuPower Ultra", "command": "~/.local/bin/nitro-cpu Ultra", "keys": "CTRL + ALT + 4" },
    { "description": "CpuPower Max", "command": "~/.local/bin/nitro-cpu Max", "keys": "CTRL + ALT + 5" },
    { "description": "Nbfc Auto", "command": "~/.local/bin/nitro-fans Auto", "keys": "CTRL + ALT + A" },
    { "description": "Nbfc Max", "command": "~/.local/bin/nitro-fans Max", "keys": "CTRL + ALT + M" }
  ],
  "autostart": [
    {
      "name": "Limitar cpu",
      "command": "~/.local/bin/nitro-cpu Base --no-notify",
      "desktop": "",
      "delay": 0,
      "workspace": "",
      "enabled": true
    },
    {
      "name": "Controlar fans",
      "command": "~/.local/bin/nitro-fans Auto --no-notify",
      "desktop": "",
      "delay": 0,
      "workspace": "",
      "enabled": true
    }
  ]
}
